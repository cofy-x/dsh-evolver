{
  "name": "dsh-evolver",
  "description": "Auditable, verifier-gated self-evolution for DeepSeek Harness.",
  "version": "0.1.0-alpha.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofy-x/dsh-evolver.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.vitest.json --pretty false",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "test:package": "pnpm run build && node scripts/check-package.mjs",
    "test": "pnpm run check:compatibility && vitest run && node --test scripts/check-release.test.mjs scripts/compatibility.test.mjs scripts/runtime-e2e/budget.test.mjs scripts/benchmark/benchmark.test.mjs scripts/benchmark/experiment.test.mjs",
    "test:experience": "pnpm run build && node scripts/benchmark/experience-check.mjs && node scripts/benchmark/experience-loop-check.mjs",
    "test:runtime": "pnpm run build && node scripts/runtime-e2e.mjs",
    "test:deepseek-offline": "pnpm run build && node scripts/runtime-e2e.mjs --deepseek-dry-run && node scripts/runtime-e2e/faults.mjs",
    "benchmark:offline": "pnpm run build && node scripts/benchmark.mjs",
    "test:benchmark": "pnpm run build && node scripts/benchmark/check.mjs",
    "test:benchmark-adapter": "pnpm run build && node scripts/benchmark/adapter-check.mjs",
    "build": "node scripts/clean-lib.mjs && tsc -b --force && tsdown --config tsdown.config.ts",
    "prepare": "pnpm run build",
    "prepack": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./domain": {
      "types": "./lib/types/domain.d.ts",
      "default": "./lib/domain.js"
    },
    "./store": {
      "types": "./lib/types/store.d.ts",
      "default": "./lib/store.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "docs/**/*.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/dsh-brand": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/dsh-commands": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/dsh-session": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-alpha.2 <0.1.6-0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-commands": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.7.3",
    "semver": "7.8.5",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
